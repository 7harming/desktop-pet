{
  "name": "desktop-pet",
  "version": "0.7.3",
  "description": "打工貓貓",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/make-test-pack.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/make-test-pack.mjs && playwright test",
    "test:e2e:hidden": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-hidden.ps1",
    "start": "npm run build && electron .",
    "check-pack": "node dist/check-pack.js",
    "dist": "node scripts/require-installer-password.mjs && npm run build && electron-builder --win nsis",
    "set-installer-password": "node scripts/set-installer-password.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "local.desktoppet",
    "productName": "打工貓貓",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packs",
        "to": "packs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "打工貓貓"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "打工貓貓"
    }
  }
}
